* { 
    box-sizing: border-box; 
} 
 
body { 
    margin: 0; 
    font-family: Arial, sans-serif; 
    background-color: #fff3e0; 
    color: #3e2723; 
} 
 
 
/* ENCABEZADO */ 
 
header { 
    background-color: #d35400; 
    color: white; 
    text-align: center; 
    padding: 25px; 
} 
 
header h1 { 
    margin: 0; 
    font-size: 35px; 
} 
 
header p { 
    margin: 8px 0 0; 
} 
 
 
/* MENU */ 
 
nav { 
    background-color: #e67e22; 
    text-align: center; 
    padding: 15px; 
} 
 
nav a { 
    color: white; 
    text-decoration: none; 
    font-weight: bold; 
    margin: 0 15px; 
} 
 
nav a:hover { 
    text-decoration: underline; 
} 
 
 
/* CONTENEDOR PRINCIPAL */ 
 
main { 
    width: 100%; 
    padding: 20px; 
} 
 
.ficha { 
    background-color: #ffffff; 
    width: 95%; 
    max-width: 1100px; 
    margin: 0 auto; 
    padding: 20px; 
    border-radius: 15px; 
    box-shadow: 0 5px 20px rgba(80, 40, 10, 0.20); 
} 
 
.ficha h2 { 
    text-align: center; 
    color: #d35400; 
    font-size: 28px; 
    margin: 0 0 10px 0; 
} 
 
.intro { 
    text-align: center; 
    font-size: 16px; 
    margin: 0 0 20px 0; 
} 
 
.galeria { 
    display: flex; 
    justify-content: center; 
    align-items: stretch; 
    gap: 20px; 
    flex-wrap: nowrap; 
} 
 
.tarjeta { 
    background-color: #fff8f0; 
    width: 30%; 
    padding: 15px; 
    text-align: center; 
    border-radius: 12px; 
    border: 1px solid #f0c9a5; 
    box-shadow: 0 3px 10px rgba(80, 40, 10, 0.12); 
 
    display: flex; 
    flex-direction: column; 
} 
 
.tarjeta img { 
    width: 100%; 
    height: 180px; 
    object-fit: cover; 
    border-radius: 10px; 
} 
 
.tarjeta h3 { 
    color: #d35400; 
    font-size: 20px; 
    margin: 10px 0; 
} 
 
.tarjeta p { 
    line-height: 1.4; 
    margin: 5px 0; 
    flex-grow: 1; 
} 
 
.boton { 
    display: block; 
    background-color: #e67e22; 
    color: white; 
    text-decoration: none; 
    padding: 8px 15px; 
    border-radius: 6px; 
    margin-top: 10px; 
    text-align: center; 
} 
 
.boton:hover { 
    background-color: #d35400; 
} 
 
 
/* IMAGEN DE LAS FICHAS */ 
 
.foto-personaje { 
    display: block; 
    width: 250px; 
    height: 300px; 
    object-fit: cover; 
    margin: 20px auto; 
    border-radius: 10px; 
} 
 
 
/* BIOGRAFIA */ 
 
.biografia { 
    margin-top: 25px; 
} 
 
.biografia h3 { 
    color: #d35400; 
} 
 
.biografia p { 
    line-height: 1.7; 
    text-align: justify; 
} 
 
 
/* TABLA */ 
 
table { 
    width: 100%; 
    border-collapse: collapse; 
    margin-top: 15px; 
} 
 
th { 
    background-color: #d35400; 
    color: white; 
    padding: 12px; 
} 
 
td { 
    padding: 12px; 
    text-align: center; 
    border: 1px solid #e6c9b5; 
} 
 
 
/* BOTONES INFERIORES */ 
 
.navegacion-ficha { 
    display: flex; 
    justify-content: space-between; 
    margin-top: 30px; 
} 
 
 
/* PIE DE PAGINA */ 
 
footer { 
    background-color: #d35400; 
    color: white; 
    text-align: center; 
    padding: 15px; 
} 
 
 
/* CELULAR */ 
 
@media (max-width: 700px) { 
 
    nav a { 
        display: block; 
        margin: 10px; 
    } 
 
    .ficha { 
        width: 95%; 
        padding: 20px; 
    } 
 
    .tarjeta { 
        width: 100%; 
        max-width: 350px; 
    } 
 
    .navegacion-ficha { 
        flex-direction: column; 
        gap: 10px; 
    } 
 
}

